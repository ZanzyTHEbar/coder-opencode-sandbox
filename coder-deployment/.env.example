# Coder public URL (must match your reverse proxy / DNS). Not localhost for real templates.
# See https://coder.com/docs/install/docker
CODER_ACCESS_URL=https://dev.example.com

# Pin server image (optional). Default in compose: latest
# CODER_VERSION=v2.27.0

# Host port published for Coder UI (maps to container 4099). Default 4099.
# CODER_HOST_PORT=4099

# If Docker workspaces fail with permission denied on docker.sock: getent group docker | cut -d: -f3
# Then uncomment group_add in docker-compose.yml and set:
# DOCKER_GID=998

# Dedicated PostgreSQL (docker-compose database service) — required for Coder DB.
# Set a strong secret in production (Coolify: add as secret).
POSTGRES_USER=coder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=coder

# Optional: stable Docker volume names on the host (Coolify redeploys).
# POSTGRES_DATA_VOLUME_NAME=coder_opencode_sandbox_postgres_data

# Authentik OIDC (create an OIDC provider in Authentik for Coder).
CODER_OIDC_ISSUER_URL=https://auth.example.com/application/o/coder/
CODER_OIDC_CLIENT_ID=<from Authentik>
CODER_OIDC_CLIENT_SECRET=<from Authentik>
CODER_OIDC_EMAIL_FIELD=email
CODER_OIDC_USERNAME_FIELD=preferred_username

# After first admin exists: true (OIDC only). For first-time setup wizard, use false — see docs/COOLIFY_E2E.md §4.
CODER_DISABLE_PASSWORD_AUTH=true

# API token lifetime caps (Coder defaults: 168h = 7 days for UI-created tokens unless raised).
# CODER_DEFAULT_TOKEN_LIFETIME=8760h
# CODER_MAX_ADMIN_TOKEN_LIFETIME=8760h
