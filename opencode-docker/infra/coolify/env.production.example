OPENCODE_VERSION=latest
NERD_FONT_VERSION=latest
OPENCODE_DOCKER_IMAGE=coder-opencode-docker:local
OPENCODE_HOSTNAME=opencode-runtime

OPENCODE_HOME_PATH=/srv/opencode/home
OPENCODE_PROJECTS_PATH=/srv/opencode/projects
OPENCODE_LOGS_PATH=/srv/opencode/logs
OPENCODE_ATTACH_BIND=127.0.0.1
OPENCODE_ATTACH_PORT=4096
OPENCODE_SERVER_CWD=/home/coder/opencode-hub
OPENCODE_DISABLE_AUTOUPDATE=true
OPENCODE_EXPERIMENTAL=1
OPENCODE_EXPERIMENTAL_WORKSPACES=true
OPENCODE_EXPERIMENTAL_HTTPAPI=true
OPENCODE_EXPERIMENTAL_SMART_RULES=true
OPENCODE_EXPERIMENTAL_BASH_BACKGROUND=true
OPENCODE_EXPERIMENTAL_LSP_TOOL=true
OPENCODE_EXPERIMENTAL_PLAN_MODE=true
OPENCODE_EXPERIMENTAL_FILEWATCHER=true
MEMORY_BANK_ROOT=/home/coder/.local/share/opencode/memory-bank

OPENCODE_APP_SHARE=private
OPENCODE_REQUIRE_PASSWORD=true
OPENCODE_SERVER_PASSWORD=
OPENCODE_CHOWN_RECURSIVE=false

GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

OPENCODE_CONFIG_URL=
OPENCODE_CONFIG_REF=
OPENCODE_CONFIG_SUBDIR=
WORKSPACE_REPO_URLS=

WORKSPACE_BOOTSTRAP_URL=
WORKSPACE_BOOTSTRAP_COMMAND=
WORKSPACE_BOOTSTRAP_TIMEOUT_SECONDS=600
WORKSPACE_BOOTSTRAP_FAILURE_POLICY=warn

LINUX_DOTFILES_URL=
LINUX_DOTFILES_REF=
LINUX_DOTFILES_SUBDIR=
LINUX_DOTFILES_INSTALL_COMMAND=./install --host opencode-runtime
